# Optional identifying User-Agent for the public Nominatim geocoding service.
# Set this in the backend environment when deploying or running at scale.
NOMINATIM_USER_AGENT=VELTRIX-Smart-Parking/1.0 (contact@example.com)

# Frontend API URL (Vite exposes VITE_* values to browser code; never put secrets here)
VITE_API_URL=http://localhost:8000

# Backend: comma-separated deployed frontend origins, for example https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:5173
