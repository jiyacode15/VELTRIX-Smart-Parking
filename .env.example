# Optional identifying User-Agent for the public Nominatim geocoding service.
# Set this in the backend environment when deploying or running at scale.
NOMINATIM_USER_AGENT=VELTRIX-Smart-Parking/1.0 (contact@example.com)

# Optional frontend API override. Leave unset for Vercel same-origin /api routing.
# Local Vite development defaults to http://localhost:8000.
# VITE_API_URL=

# Same-origin Vercel API calls do not need CORS. Add exact origins only for external clients.
# Backend: comma-separated origins, for example https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:5173

# Optional SQLAlchemy URL. On Vercel without this, demo SQLite is copied to ephemeral /tmp.
# DATABASE_URL=
